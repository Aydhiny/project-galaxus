{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galaxus",
  "version": "0.1.0",
  "identifier": "app.galaxus.desktop",
  "build": {
    "frontendDist": "https://project-galaxus.vercel.app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Galaxus",
        "url": "https://project-galaxus.vercel.app/productivity",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Tasks, routines and habits",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
